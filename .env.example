# Mini Orbit Mail - Environment Configuration Template
# Copy this file to .env and customize for your environment

# Application Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
SERVER_IP=127.0.0.1

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/mini_orbit

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_32_chars_min
JWT_EXPIRES_IN=7d

# Redis In-Memory Cache & Verification Store
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# RabbitMQ Message Broker
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672

# Mail Engine & Transport Settings
# When MAIL_HOST is unset, outbound email will attempt direct MX delivery with DKIM signing.
# To relay through an external SMTP provider (AWS SES, SendGrid, Mailgun, Gmail), uncomment below:
# MAIL_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
IMAP_PORT=993
MAIL_TLS=false

# Initial System Admin Account (auto-seeded on first run)
INITIAL_ADMIN_EMAIL=admin@orbitmail.local
INITIAL_ADMIN_PASSWORD=AdminPassword123!
