# ==========================================
# MINI ORBIT MAIL - SERVER CONFIGURATION
# ==========================================
NODE_ENV=development
PORT=4000

# Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/mini_orbit

# JWT Authentication
JWT_SECRET=mini_orbit_super_secret_jwt_key_2026_xyz
JWT_EXPIRES_IN=7d

# Frontend CORS Whitelist (Comma-separated in production)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Server Public IP (Used for dynamic SPF record generation)
# Replace with your actual server public IP when in production:
SERVER_IP=127.0.0.1

# ==========================================
# SMTP & MAIL ENGINE SETTINGS
# ==========================================
# For Local Engine (Postfix/Mailu container):
MAIL_HOST=127.0.0.1
SMTP_PORT=587
IMAP_PORT=993
MAIL_TLS=false

# Optional: Set these if using authenticated SMTP relay
SMTP_USER=munisekhar9056@gmail.com
SMTP_PASS=twmv jisj tjhi bymw

# ==========================================
# INITIAL SEED ADMIN
# ==========================================
INITIAL_ADMIN_EMAIL=admin@orbitmail.local
INITIAL_ADMIN_PASSWORD=AdminPassword123!